# Copy to terraform.tfvars (gitignored) and adjust. No secrets and no real IDs in the example.
location    = "swedencentral"
name_prefix = "alz"
environment = "dev"

# Region must offer these models with quota (thousands of tokens per minute).
model_deployments = {
  "gpt-5.4-mini" = {
    model_name    = "gpt-5.4-mini"
    model_version = "2026-03-17"
    sku           = "GlobalStandard"
    capacity      = 10
  }
}

# Entra groups that use the Foundry project (Foundry User role on the account).
project_user_principals = {
  deployers = {
    principal_id   = "<entra-group-object-id>"
    principal_type = "Group"
  }
}

# Foundry Agent Service: true = standard setup with our own Cosmos DB, AI Search and Storage;
# false = basic setup (Microsoft-managed storage).
deploy_agent_service_dependencies = true
agent_cosmos_db_serverless        = true
agent_search_sku                  = "basic"
agent_search_replica_count        = 1

# Reuse a dedicated existing set instead of creating one (switch on only).
# existing_agent_service_dependencies = {
#   cosmos_db_resource_id       = "/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.DocumentDB/databaseAccounts/<name>"
#   ai_search_resource_id       = "/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Search/searchServices/<name>"
#   storage_account_resource_id = "/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<name>"
# }

# Empty: all networks, Entra ID still required.
allowed_ip_ranges = []

tags = {
  owner = "<team or alias>"
}
