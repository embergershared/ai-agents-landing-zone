# Copy to terraform.tfvars (gitignored) and adjust. No secrets and no real IDs in the example.
location                   = "swedencentral"
name_prefix                = "alz"
environments               = ["dev"]
replication_type           = "ZRS"
soft_delete_retention_days = 30

# Object IDs that read and write state, besides the identity running the bootstrap.
state_contributor_principal_ids = []

# Pipeline identity for GitHub Actions (docs/ci-cd.md, Deploys): the repository, and per GitHub
# environment the scope it deploys to.
# subject_prefix: only when GitHub sends immutable subjects; read it with
#   gh api repos/<owner>/<repo>/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_deployer = {
#   repository     = "<owner>/<repo>"
#   subject_prefix = "repo:<owner>@<owner-id>/<repo>@<repo-id>"
#   environments = {
#     dev = "/subscriptions/<subscription-id>/resourceGroups/<landing-zone resource group>"
#   }
# }

# Empty: all networks, Entra ID still required.
allowed_ip_ranges = []

tags = {
  owner = "<team or alias>"
}
