# ---- Secrets: never committed (the *.example / *.sample / *.template files are) ----
.env
.env.*
!.env.example
!.env.sample
!.env.template
config.env
*.pfx
*.pem
*.key
secrets.json

# ---- Local data: backups and artifacts ----
backups/
artifacts/

# ---- Terraform: state, plugins and local overrides (.terraform.lock.hcl is committed) ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-environment values of the landing zone are committed (no secrets, no real IDs).
!src/landing-zone/environments/*.tfvars
*.tfplan
*.backend.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---- Node (tooling only) ----
node_modules/

# ---- Editors and tools ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.azure/

# ---- Logs and OS files ----
logs/
*.log
Thumbs.db
.DS_Store
