# ---- Secrets: never committed (the *.example / *.sample / *.template files are) ----
.env
.env.*
!.env.example
!.env.sample
!.env.template
config.env
*.pfx
*.pem
*.key
secrets.json

# ---- Local data: databases, their WAL files and backups ----
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
backups/
artifacts/

# ---- Terraform: state, plugins and local overrides (.terraform.lock.hcl is committed) ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---- .NET ----
bin/
obj/
TestResults/
*.trx
*.user
*.suo
*.csproj.lscache
.vs/
*.nupkg
*.snupkg
BenchmarkDotNet.Artifacts/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Node (tooling only) ----
node_modules/

# ---- Editors and tools ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.azure/

